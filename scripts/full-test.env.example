# Full-group runner inputs; documentation only, not automatically loaded.
# Leave empty unless a separate disposable remote sandbox grant exists.
# The runner accepts exactly "authorized" after that independent grant.
DISK_FULL_TEST_REMOTE_SANDBOX=
# Empty means native linker. "zig" explicitly refuses the full fuzz group.
CI_LINKER_BOOTSTRAP=
# Set by the plugin runner: ordinary=0; paired real daemon integration=1.
DISK_PLUGIN_INTEGRATION=0
