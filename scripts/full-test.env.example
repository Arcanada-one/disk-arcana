# Full-group runner inputs; documentation only, not automatically loaded.
# Leave empty unless a separate disposable remote sandbox grant exists.
# "authorized" is only an opt-in, never a grant. The current runner still
# refuses: no authenticated account/bucket/grant/revocation consumer is wired.
# Source review and a genuine supported authority binding are required to open
# this path; credentials or a local declaration cannot substitute for them.
DISK_FULL_TEST_REMOTE_SANDBOX=
# Empty means native linker. "zig" explicitly refuses the full fuzz group.
CI_LINKER_BOOTSTRAP=
# Set by the plugin runner: ordinary=0; paired real daemon integration=1.
DISK_PLUGIN_INTEGRATION=0
# Rust isolation fixture/CI install destination. ci-isolate-rust.py sets this
# to the job-owned CARGO_HOME; fixtures reject a shared-home override.
# Empty here is documentation only, never a runtime export.
CARGO_INSTALL_ROOT=
# CLI local E2E binary discovery. Cargo supplies the crate directory during tests;
# do not override it when invoking Cargo.
CARGO_MANIFEST_DIR=
# Optional Cargo output directory; the fixture also checks its own executable's
# profile directory and the workspace defaults when locating the server binary.
CARGO_TARGET_DIR=
# Optional explicit locally built server executable for the synthetic E2E test.
# This path is a test input, not permission to run a production server.
DISK_ARCANA_SERVER_BIN=
# Optional explicit test daemon locator; absent retains Cargo discovery.
# Explicit invalid paths refuse. The verifier separately binds authentic
# artifact manifests and immutable executable digests before any launch.
DISK_ARCANA_DAEMON_BIN=
# Linux CI artifact exporter inputs. GitHub supplies these job identities and
# output path; the build step supplies the expected checkout and target.
# Documentation only: do not source this file to create CI identity or authority.
GITHUB_ACTIONS=
RUNNER_OS=
GITHUB_WORKSPACE=
EXPECTED_BUILD_SHA=
CI_ISOLATED_RUST_ROOT=
BUILD_TARGET=
GITHUB_REPOSITORY=
GITHUB_RUN_ID=
GITHUB_RUN_ATTEMPT=
GITHUB_JOB=
RUNNER_NAME=
GITHUB_OUTPUT=
