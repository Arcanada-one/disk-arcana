# INFRA-0370 — runner users may invoke the disk-arcana unit broker and nothing else.
# Bootstrap: deploy/linux/install-disk-arcana-install-unit-broker.sh (root, once).
ci-runner ALL=(root) NOPASSWD: /usr/local/sbin/disk-arcana-install-unit
ci-runner-ci ALL=(root) NOPASSWD: /usr/local/sbin/disk-arcana-install-unit
